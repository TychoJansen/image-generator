# Cloudflare account ID (dashboard: Workers & Pages > Overview, right sidebar)
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare API token with the "Workers AI" permission (My Profile > API Tokens)
CLOUDFLARE_API_TOKEN=

# Password for the Generate tab (word list, context, photos and generating)
ADMIN_PASSWORD=

# Optional: OpenAI API key, to also generate images with OpenAI (paid per image)
# (platform.openai.com > API keys)
OPENAI_API_KEY=

# Optional: OpenAI image model (default: gpt-image-2.5-sunburst). Alternatives: gpt-image-2, gpt-image-1.5, gpt-image-1
# OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst

# Optional: port (default: 3000)
# PORT=3000

# Optional: address to listen on (default: 127.0.0.1 = only this computer; the tunnel still works)
# HOST=127.0.0.1

# Optional: folder for all data: database, generated images and reference photos (default: data)
# DATA_DIR=data

# Optional: text file that is put into "Altijd meesturen" at startup when it is new or changed (default: context.txt).
# Leave empty to switch this off.
# CONTEXT_FILE=context.txt
