# Cloudflare account ID (dashboard: Workers & Pages > Overview, right sidebar)
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare API token with the "Workers AI" permission (My Profile > API Tokens)
CLOUDFLARE_API_TOKEN=

# Password for the Generate tab (word list, context, photos and generating)
ADMIN_PASSWORD=

# Optional: OpenAI API key, to also generate images with OpenAI (paid per image)
# (platform.openai.com > API keys)
OPENAI_API_KEY=

# Optional: OpenAI image model (default: gpt-image-2.5-sunburst). Alternatives: gpt-image-2, gpt-image-1.5, gpt-image-1
# OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst

# Optional: port (default: 3000)
# PORT=3000
