# Cloudflare account ID (dashboard: Workers & Pages > Overview, right sidebar)
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare API token with the "Workers AI" permission (My Profile > API Tokens)
CLOUDFLARE_API_TOKEN=

# Password for the Generate tab (word list, context, photos and generating)
ADMIN_PASSWORD=

# Optional: port (default: 3000)
# PORT=3000
